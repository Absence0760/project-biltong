# Resend API key — get one from https://resend.com/api-keys
RESEND_API_KEY=

# The "from" address used on outgoing emails.
# Must be a verified sender/domain in your Resend account.
FROM_EMAIL="Thong Biltong <orders@example.com>"

# The address that receives new order notifications.
OWNER_EMAIL=orders@example.com

# Comma-separated list of origins allowed to call this API.
# In prod, set this to your CloudFront domain (e.g. https://thongbiltong.co.za).
ALLOWED_ORIGINS=http://localhost:7777

# Public URL of the site — used to build tracking links in confirmation emails.
SITE_URL=http://localhost:7777

# Sanity — server-side credentials for reading and writing order documents.
# Get the project ID from https://www.sanity.io/manage.
# Create the API token under the project's API → Tokens tab with Editor role
# (or a custom role scoped to the `order` type if you want tighter permissions).
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# Shared secret for verifying Sanity webhook signatures. Generate a random
# string (e.g. `openssl rand -hex 32`) and paste the same value into Sanity's
# webhook configuration.
SANITY_WEBHOOK_SECRET=

# Stripe payment gateway.
# Register at https://dashboard.stripe.com — no monthly fee, pay-per-transaction.
# Use the test-mode keys (sk_test_... / pk_test_... / whsec_...) while developing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Currency passed to Stripe Checkout sessions (ISO 4217, lowercase).
STRIPE_CURRENCY=zar

# Optional. Overrides the backend's own base URL when building Stripe
# success/cancel redirect URLs and webhook URLs. In production it's derived
# from the incoming request; locally set it to the frontend dev URL. For
# webhook testing use `stripe listen --forward-to localhost:3001/stripe/webhook`.
API_URL=http://localhost:3001

# Port for local dev server.
PORT=3001
